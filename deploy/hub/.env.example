# Copy to .env on the droplet and fill in. Generate each password with:
#   openssl rand -hex 24
# (hex passwords are safe inside a database URL)

POSTGRES_PASSWORD=change-me
HORMIGAS_DB_PASSWORD=change-me
HORMIGAS_WORLD_NAME=The Backyard

# Optional: GitHub token that can open issues in MarcialPimentel/hormigas (see docs/DEPLOY.md).
# Leave empty to keep in-game feedback in the database only.
HORMIGAS_FEEDBACK_GITHUB_TOKEN=
