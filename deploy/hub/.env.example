# Copy to .env on the droplet and fill in. Generate each password with:
#   openssl rand -hex 24
# (hex passwords are safe inside a database URL)

POSTGRES_PASSWORD=change-me
HORMIGAS_DB_PASSWORD=change-me
HORMIGAS_WORLD_NAME=The Backyard

# Optional: secret phrase for the private feedback page (see docs/DEPLOY.md), 16+ characters.
# Leave empty to keep the page switched off.
HORMIGAS_FEEDBACK_KEY=
