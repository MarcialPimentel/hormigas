# Caddy gets and renews HTTPS certificates automatically and passes
# WebSockets through without extra settings.
# Each site needs a DNS A record pointing at the droplet's IP.

hormigas.marz.gg {
	encode gzip
	reverse_proxy hormigas:3000
}

# Guildie realtime rooms (the living city). Repo: guildie realtime/deploy/Caddyfile-block
guildie.marz.gg {
	@rooms path /q/* /health
	handle @rooms {
		reverse_proxy guildie-realtime:8788
	}
	handle {
		redir https://marz.gg/games/guildie/ 302
	}
}

lasthand.marz.gg {
	reverse_proxy last-hand:8790
}

# Sunk Cost (repo: sunk-cost). The game container serves both the page and the WebSocket.
sunk-cost.marz.gg {
	encode gzip
	reverse_proxy sunk-cost:8080
}

# SCRAM (repo: scram). The game container serves both the page and the WebSocket.
scram.marz.gg {
	encode gzip
	reverse_proxy scram:8791
}
