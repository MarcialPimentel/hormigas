# Copy to .env only if you need to change defaults. Defaults match docker-compose.yml.
DATABASE_URL=postgres://hormigas:hormigas@localhost:5432/hormigas
TEST_DATABASE_URL=postgres://hormigas:hormigas@localhost:5432/hormigas_test
PORT=3000
# Speed of the world created on first start (1 = design speed).
WORLD_SPEED=5
WORLD_NAME=The Backyard
# Set to true when served over HTTPS (defaults to true when NODE_ENV=production)
SECURE_COOKIES=false
# Use TLS for the database connection (hosted Postgres over the public internet)
DATABASE_SSL=false
